# LHF Ethiopia — environment variables.
# Copy to .env.local (dev) or set in your deploy platform (prod). Commit nothing.

# Site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Admin / CMS gate. Leave unset for a frontend-only deploy — admin routes
# 404 and none of the vars below are required.
# ENABLE_ADMIN=true

# Database — Postgres connection string (required when ENABLE_ADMIN=true).
# Dev: local Postgres or Neon.
# Prod on Dokploy: paste the Internal Connection URL from the standalone
# Postgres database service, e.g.
#   postgres://lhf:<password>@<internal-host>:5432/lhf
DATABASE_URL=postgres://lhf:password@localhost:5432/lhf

# Auth (required when ENABLE_ADMIN=true).
# Generate with: openssl rand -base64 32. The "dev-only-" prefix is
# rejected at runtime in production — rotate before deploying.
AUTH_SECRET=dev-only-auth-secret-replace-in-prod-please-32-chars-min
# NEXTAUTH_URL=https://lhfethiopia.org
